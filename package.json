{
  "name": "jurchen-input",
  "version": "0.1.0",
  "private": true,
  "description": "Find a Jurchen character by its stroke code, reading, radical or drawn shape, read its Unicode record, and enter it.",
  "license": "MIT",
  "author": "mkpoli",
  "homepage": "https://jurchen.mkpo.li/",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "dev": "vite app",
    "build": "vite build app",
    "preview": "vite preview app",
    "test": "bun test tests",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "i18n": "x18n check --skip key-conflict",
    "verify": "bun run test && bun run check && bun run i18n",
    "build:data": "uv run scripts/build_jurchen_data.py",
    "build:encodings": "uv run scripts/build_jurchen_encodings.py",
    "build:legacy-map": "uv run scripts/build_legacy_map.py",
    "build:shapes": "uv run scripts/build_jurchen_shapes.py",
    "build:font": "uv run scripts/build_jurchen_font.py",
    "build:icons": "bun scripts/make-icons.mjs",
    "check:site": "bun scripts/check_site.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.3.14",
    "@x18n/cli": "0.1.1",
    "playwright-core": "1.64.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
