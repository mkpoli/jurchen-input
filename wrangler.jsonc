{
  "name": "jurchen-input",
  "compatibility_date": "2026-10-30",
  // The worker serves the app for its own paths and keeps a 404 for everything else.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/strokes", "/strokes/",
      "/draw", "/draw/",
      "/radicals", "/radicals/",
      "/codes", "/codes/",
      "/reading", "/reading/",
      "/syllables", "/syllables/",
      "/transcribe", "/transcribe/",
      "/convert", "/convert/",
      "/khitan", "/khitan/",
      "/about", "/about/"
    ],
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "jurchen.mkpo.li", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
