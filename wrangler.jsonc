{
  "name": "jurchen-input",
  "compatibility_date": "2026-10-30",
  // The worker writes each page's head into the app's HTML; a miss opens the app so a link can carry a query.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/strokes", "/strokes/",
      "/draw", "/draw/",
      "/radicals", "/radicals/",
      "/codes", "/codes/",
      "/reading", "/reading/",
      "/syllables", "/syllables/",
      "/transcribe", "/transcribe/",
      "/convert", "/convert/",
      "/khitan", "/khitan/",
      "/about", "/about/"
    ],
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "jurchen.mkpo.li", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
